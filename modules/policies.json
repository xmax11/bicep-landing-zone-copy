          },
          {
            "policyDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/policyDefinitions', format('{0}-require-tags', parameters('projectName')))]"
          }
        ]
      },
      "dependsOn": [
        "[subscriptionResourceId('Microsoft.Authorization/policyDefinitions', format('{0}-enforce-https', parameters('projectName')))]",
        "[subscriptionResourceId('Microsoft.Authorization/policyDefinitions', format('{0}-audit-kv-encryption', parameters('projectName')))]",
        "[subscriptionResourceId('Microsoft.Authorization/policyDefinitions', format('{0}-require-tags', parameters('projectName')))]",
        "[subscriptionResourceId('Microsoft.Authorization/policyDefinitions', format('{0}-enforce-tls-12', parameters('projectName')))]"
