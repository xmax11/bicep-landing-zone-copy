      "name": "[format('{0}-baseline-initiative', parameters('projectName'))]",
      "properties": {
        "displayName": "[format('{0} Baseline Policy Initiative', parameters('projectName'))]",
        "description": "Baseline policies for landing zone",
        "policyType": "Custom",
        "policyDefinitions": [
          {
