          "hubVnetLinkId": "[resourceId('Microsoft.Network/privateDnsZones/virtualNetworkLinks', variables('serviceConfigs').sql.dnsZoneName, format('{0}-sql-hub-link', parameters('projectName')))]",
          "spokeVnetLinkId": "[if(greater(length(parameters('spokeVnetNames')), 0), resourceId('Microsoft.Network/privateDnsZones/virtualNetworkLinks', variables('serviceConfigs').sql.dnsZoneName, format('{0}-sql-spoke1-link', parameters('projectName'))), '')]"
        },
        {
          "serviceName": "App Service",
          "privateEndpointName": "[format('pe-{0}-appservice', parameters('projectName'))]",
          "privateEndpointId": "[resourceId('Microsoft.Network/privateEndpoints', format('pe-{0}-appservice', parameters('projectName')))]",
          "privateIpAddress": "10.100.3.7",
          "dnsZoneName": "[variables('serviceConfigs').appService.dnsZoneName]",
          "dnsZoneId": "[resourceId('Microsoft.Network/privateDnsZones', variables('serviceConfigs').appService.dnsZoneName)]",
          "hubVnetLinkId": "[resourceId('Microsoft.Network/privateDnsZones/virtualNetworkLinks', variables('serviceConfigs').appService.dnsZoneName, format('{0}-appservice-hub-link', parameters('projectName')))]",
          "spokeVnetLinkId": "[if(greater(length(parameters('spokeVnetNames')), 0), resourceId('Microsoft.Network/privateDnsZones/virtualNetworkLinks', variables('serviceConfigs').appService.dnsZoneName, format('{0}-appservice-spoke1-link', parameters('projectName'))), '')]"
        }
      ]
    },
    "hubVnetId": {
      "type": "string",
      "value": "[extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', parameters('subscriptionId'), split(resourceGroup().id, '/')[4]), 'Microsoft.Network/virtualNetworks', parameters('hubVnetName'))]"
    },
    "spokeVnetIds": {
      "type": "array",
      "copy": {
        "count": "[length(range(0, length(parameters('spokeVnetNames'))))]",
        "input": "[if(equals(range(0, length(parameters('spokeVnetNames')))[copyIndex()], 0), extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', parameters('subscriptionId'), split(resourceGroup().id, '/')[4]), 'Microsoft.Network/virtualNetworks', parameters('spokeVnetNames')[0]), if(equals(range(0, length(parameters('spokeVnetNames')))[copyIndex()], 1), extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', parameters('subscriptionId'), split(resourceGroup().id, '/')[4]), 'Microsoft.Network/virtualNetworks', parameters('spokeVnetNames')[1]), if(equals(range(0, length(parameters('spokeVnetNames')))[copyIndex()], 2), extensionResourceId(format('/subscriptions/{0}/resourceGroups/{1}', parameters('subscriptionId'), split(resourceGroup().id, '/')[4]), 'Microsoft.Network/virtualNetworks', parameters('spokeVnetNames')[2]), '')))]"
      }
    },
    "dnsZoneIds": {
      "type": "object",
      "value": {
        "keyVault": "[resourceId('Microsoft.Network/privateDnsZones', variables('serviceConfigs').keyVault.dnsZoneName)]",
        "storage": "[resourceId('Microsoft.Network/privateDnsZones', variables('serviceConfigs').storage.dnsZoneName)]",
        "sql": "[resourceId('Microsoft.Network/privateDnsZones', variables('serviceConfigs').sql.dnsZoneName)]",
        "appService": "[resourceId('Microsoft.Network/privateDnsZones', variables('serviceConfigs').appService.dnsZoneName)]",
        "cosmosDb": "[resourceId('Microsoft.Network/privateDnsZones', variables('serviceConfigs').cosmosDb.dnsZoneName)]"
      }
    }
  }
